# ==========================================
# Vivah AI - Environment Variables
# ==========================================
# Duplicate this file to .env and fill in your values
# cp .env.example .env

# ------------------------------------------
# Supabase Configuration (Frontend & Scripts)
# ------------------------------------------
# Your Supabase Project URL (Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase Public Anonymous API Key (Project Settings -> API)
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Supabase Service Role Key (Optional: Required for running backfill-embeddings.js script)
VITE_SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ------------------------------------------
# AI Provider Keys (Frontend, Embeddings & Gateway)
# ------------------------------------------
# Google Gemini API Key for vector embeddings & AI features
# Get one at: https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_API_KEY=your_google_gemini_api_key_here

# Groq API Key for LLM matchmaking reasoning & profile optimization
# Get one at: https://console.groq.com/keys
VITE_GROQ_API_KEY=your_groq_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Groq Model (default: llama-3.1-8b-instant, with automatic fallback)
GROQ_MODEL=llama-3.1-8b-instant

# ------------------------------------------
# Supabase Edge Functions Secrets (Optional / Deployment)
# ------------------------------------------
# Set these via `supabase secrets set` if deploying edge functions
# MESSAGE_ENCRYPTION_KEY_BASE64=your_32_byte_base64_encoded_aes_key
# MESSAGE_ENCRYPTION_ACTIVE_VERSION=1

